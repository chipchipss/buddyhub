# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
# /server：不带 -o 直接 `go build ./cmd/server` 的默认产物名（Linux/macOS 无 .exe 后缀）。
/login
/credit
/buddyhub
/signin_bin
/server

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md

# Windows binaries
/buddyhub.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe

# 本地临时产物（截图 / 验证二进制）
tmp/

# 运行时产物：测试若用空 StateFile 会把账号表落在包目录里（见 platforms_test.go）
ext-accounts.json
zai-accounts.json
state.json
usage.json

# 运行时日志（若误在仓库根起服务会产生）
/server.log
/server.err.log

# 本机专属的 compose 覆写（改端口绑定、加外部网络、换 TZ/卷路径）。
# docker compose 会自动合并同目录的 docker-compose.override.yml，所以它是「在我这台机器
# 上跟默认不一样」的正确落点——不用在部署机上背一个本地 commit（背了就要 reset --hard +
# cherry-pick，一旦上游也改 docker-compose.yml 就必冲突，见 README 方式一）。
docker-compose.override.yml

# 参考仓库 / 调研产物（外来项目，不属于本仓库）
/ima2api/
/marvis2api/
/tencent-ima-copilot-mcp/
/refs/
